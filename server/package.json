{
  "name": "@iatomic/server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && node -e \"require('fs').copyFileSync('src/schema.sql','dist/schema.sql')\"",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "db:schema": "tsx src/seed.ts --schema-only",
    "db:seed": "tsx src/seed.ts",
    "db:schema:prod": "node dist/seed.js --schema-only",
    "db:seed:prod": "node dist/seed.js"
  },
  "dependencies": {
    "cookie-parser": "^1.4.6",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "tsx": "^4.16.2",
    "typescript": "^5.4.5"
  }
}
