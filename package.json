{
  "name": "iatomic-magazine",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "api",
    "server"
  ],
  "scripts": {
    "dev:frontend": "npm run dev -w frontend",
    "dev:api": "npm run dev -w api",
    "dev:server": "npm run dev -w server",
    "build": "npm run build -w frontend && npm run build -w api",
    "build:fullstack": "npm run build -w frontend && npm run build -w server",
    "start:server": "npm run start -w server",
    "deploy:api": "npm run deploy -w api",
    "deploy:frontend": "npm run deploy -w frontend",
    "db:generate": "npm run db:generate -w api",
    "db:migrate": "npm run db:migrate -w api",
    "db:seed": "npm run db:seed -w api",
    "server:db:schema": "npm run db:schema -w server",
    "server:db:seed": "npm run db:seed -w server"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.4.5"
  }
}
