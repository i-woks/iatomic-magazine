name = "iatomic-api"
main = "src/index.ts"
compatibility_date = "2024-05-12"
compatibility_flags = ["nodejs_compat"]

account_id = "144fbcd4f86a4569675d40cd5804d6e4"

[vars]
API_BASE_PATH = "/api"
AI_PROVIDER = "deepseek"
AI_MODEL = "deepseek-chat"
AI_API_BASE_URL = "https://api.deepseek.com"
ADMIN_BASE_PATH = "/control/iatomic-panel"
# PUBLIC_MEDIA_BASE_URL = "https://pub-xxx.r2.dev"  # Uncomment if you configure a public R2 domain

# Secrets (set via: wrangler secret put <SECRET_NAME>)
# AI_API_KEY
# N8N_MCP_SERVER_URL
# ADMIN_SESSION_SECRET
# ADMIN_EMAIL
# ADMIN_INITIAL_PASSWORD
# SETUP_SECRET
# CRON_SECRET

[[d1_databases]]
binding = "DB"
database_name = "iatomic-db"
database_id = "0de942a7-6a1d-43e3-a0fc-7fe0b28876f5"

[[r2_buckets]]
binding = "MEDIA_BUCKET"
bucket_name = "iatomic-media"

[[kv_namespaces]]
binding = "CACHE"
id = "3fb63a94a8974df095cb04ad4c2292f7"

# Cron trigger for AI article automation (runs daily at 9am UTC)
[triggers]
crons = ["0 9 * * *"]

[env.production]
name = "iatomic-api"

[[env.production.d1_databases]]
binding = "DB"
database_name = "iatomic-db"
database_id = "0de942a7-6a1d-43e3-a0fc-7fe0b28876f5"

[[env.production.r2_buckets]]
binding = "MEDIA_BUCKET"
bucket_name = "iatomic-media"

[[env.production.kv_namespaces]]
binding = "CACHE"
id = "3fb63a94a8974df095cb04ad4c2292f7"

[env.production.triggers]
crons = ["0 9 * * *"]
