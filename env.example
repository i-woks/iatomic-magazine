# ─── iAtomic Magazine — Environment Variables Example ─────────────────────────
# Copy this file and set all values as Cloudflare secrets or GitHub Actions secrets.
# NEVER commit real values. Use: wrangler secret put <NAME>

# ── Admin ──────────────────────────────────────────────────────────────────────
ADMIN_EMAIL=MrLu3ifer@gmail.com
ADMIN_INITIAL_PASSWORD=           # Set securely via: wrangler secret put ADMIN_INITIAL_PASSWORD
ADMIN_BASE_PATH=/control/iatomic-panel
SETUP_SECRET=                     # Random secret for one-time admin setup endpoint
ADMIN_SESSION_SECRET=             # Strong random secret for session signing

# ── AI Automation ──────────────────────────────────────────────────────────────
AI_PROVIDER=deepseek
AI_API_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
AI_API_KEY=                       # Your DeepSeek API key — set via: wrangler secret put AI_API_KEY
N8N_MCP_SERVER_URL=https://atomicmagazine.app.n8n.cloud/mcp-server/http
CRON_SECRET=                      # Random secret for cron endpoint security

# ── Cloudflare Resources ───────────────────────────────────────────────────────
# D1 Database binding: DB (database_name: iatomic-db)
# R2 Bucket binding:   MEDIA_BUCKET (bucket_name: iatomic-media)
# KV Namespace binding: CACHE
PUBLIC_MEDIA_BASE_URL=            # Optional: public R2 domain e.g. https://media.iatomic.ir

# ── Frontend (set in GitHub Actions or .env.local for dev) ────────────────────
VITE_API_URL=https://iatomic-api.iwok3m.workers.dev
VITE_ADMIN_BASE_PATH=/control/iatomic-panel

# ── GitHub Actions Secrets (set in repo Settings > Secrets > Actions) ─────────
CLOUDFLARE_API_TOKEN=             # Cloudflare API token with Pages + Workers + D1 + R2 permissions
